{
    "schema_url": "https://gitlab.com/cyverse/cacao-common/-/raw/master/template/ui-schemas/v1/schema.json",
    "schema_version": "1",
    "author": "Sean Davey",
    "author_email": "sdavey@arizona.edu",
    "steps": [
        {
            "title": "Parameters",
            "items": [
                {
                    "name": "region",
                    "ui_label": "Choose Region"
                },
                {
                    "name": "instance_name",
                    "ui_label": "Instance name"
                },
                {
                    "name": "power_state",
                    "ui_label": "Power state"
                },
                {
                    "name": "image_name",
                    "ui_label": "Boot image name",
                    "parameters": [
                        { "key": "windows_disclaimer", "value": true }
                    ]
                },
                {
                    "type": "row",
                    "items":[
                        {
                            "name": "instance_count",
                            "ui_label": "# of Instances"
                        },
                        {
                            "name": "flavor",
                            "ui_label": "Size"
                        }
                    ]
                },
                {
                    "name": "vm_usernames",
                    "ui_label": "VM usernames (one per instance)",
                    "help_text": "Comma-separated list, e.g. alice,bob,carol. Must match # of Instances. Leave blank to use the image default user."
                },
                {
                    "name": "vm_passwords",
                    "field_type": "password",
                    "ui_label": "VM passwords (one per username)",
                    "help_text": "Comma-separated, positionally matched to VM usernames, e.g. pw1,pw2,pw3. Passwords cannot contain commas. Leave blank for SSH-key-only access."
                },
                {
                    "type": "advanced_settings",
                    "collapsible": true,
                    "title": "Advanced",
                    "items": [
                        {
                            "name": "root_storage"
                        },
                        {
                            "name": "do_shelve_cycle",
                            "ui_label": "Shelve/unshelve after configuration",
                            "help_text": "Shelve then unshelve each VM after Ansible completes to refresh the guest on a new hypervisor. Disable to skip."
                        }
                    ]
                }
            ]
        }
    ]
}
